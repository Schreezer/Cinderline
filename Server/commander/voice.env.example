# Copy to the ignored Server/.env.local and fill values locally. Never bundle
# this file's populated copy into the game or expose it to the game web server.
OPENAI_API_KEY=
TYPESAFE_API_KEY=
CINDER_VOICE_ACCESS_TOKEN=
CINDER_VOICE_HOST=127.0.0.1
CINDER_VOICE_PORT=8789
# Default is Jev -> Luna. Explicitly use luna for a direct-Luna comparison or
# while TypeSafe access has not been configured; no silent provider substitution.
CINDER_VOICE_ROUTING=jev
CINDER_JEV_MODEL=jev-latest
CINDER_LUNA_MODEL=gpt-6-luna
CINDER_VOICE_NAME=marin
# Development typed-input harness only; leave off for normal voice sessions.
CINDER_VOICE_TYPED_INPUT=0
