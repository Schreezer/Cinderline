{
  "name": "cinderline-game-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": "./server.js",
  "scripts": {
    "start": "node index.js",
    "start:lan": "node index.js --lan",
    "test": "node --test",
    "test:commander": "node --test test/commander.test.js",
    "test:commander:live": "node commander/live-eval.js",
    "start:voice": "node --env-file-if-exists=.env.local commander/voice-server.js",
    "test:voice": "node --test test/voice-*.test.js",
    "test:voice:live": "node --env-file-if-exists=.env.local commander/live-smoke.js"
  },
  "dependencies": {
    "bonjour-service": "1.4.4",
    "ws": "8.21.3"
  }
}
