[
  {
    "start": 0.6,
    "end": 2.77,
    "text": "In 2009, young scientists"
  },
  {
    "start": 2.8,
    "end": 5.55,
    "text": "investigated fifteen detox products."
  },
  {
    "start": 5.58,
    "end": 8.24,
    "text": "Two questions for their makers."
  },
  {
    "start": 8.27,
    "end": 9.37,
    "text": "What does detox mean?"
  },
  {
    "start": 9.4,
    "end": 10.85,
    "text": "And where's the proof?"
  },
  {
    "start": 10.88,
    "end": 11.87,
    "text": "No two companies"
  },
  {
    "start": 11.9,
    "end": 13.49,
    "text": "defined it the same way."
  },
  {
    "start": 13.52,
    "end": 15.09,
    "text": "Most offered no evidence."
  },
  {
    "start": 15.12,
    "end": 16.82,
    "text": "Oh, and one product?"
  },
  {
    "start": 16.85,
    "end": 18.2,
    "text": "A hair straightener."
  },
  {
    "start": 18.23,
    "end": 20.2,
    "text": "So before buying a cleanse,"
  },
  {
    "start": 20.23,
    "end": 21.64,
    "text": "ask what it's actually"
  },
  {
    "start": 21.67,
    "end": 23.13,
    "text": "meant to remove."
  },
  {
    "start": 23.16,
    "end": 25.12,
    "text": "Detox diets lack convincing evidence"
  },
  {
    "start": 25.15,
    "end": 26.26,
    "text": "for removing toxins."
  },
  {
    "start": 26.29,
    "end": 28.68,
    "text": "Your liver processes harmful substances;"
  },
  {
    "start": 28.71,
    "end": 30.3,
    "text": "your kidneys filter waste."
  },
  {
    "start": 30.33,
    "end": 32.64,
    "text": "No straightener required."
  }
]