[
  {
    "start": 0.59,
    "end": 2.91,
    "text": "In 2009, some young scientists"
  },
  {
    "start": 2.94,
    "end": 5.14,
    "text": "called fifteen detox brands."
  },
  {
    "start": 5.17,
    "end": 6.38,
    "text": "Two questions."
  },
  {
    "start": 6.41,
    "end": 7.51,
    "text": "What does detox mean?"
  },
  {
    "start": 7.54,
    "end": 8.8,
    "text": "And where's the proof?"
  },
  {
    "start": 8.83,
    "end": 10.94,
    "text": "No two brands meant the same thing."
  },
  {
    "start": 10.97,
    "end": 12.11,
    "text": "Most had no proof."
  },
  {
    "start": 12.14,
    "end": 13.58,
    "text": "Oh, and one of them?"
  },
  {
    "start": 13.61,
    "end": 15.58,
    "text": "It was a hair straightener."
  },
  {
    "start": 15.61,
    "end": 17.04,
    "text": "Detox teas are no different."
  },
  {
    "start": 17.07,
    "end": 19.01,
    "text": "Often, it's senna. A laxative."
  },
  {
    "start": 19.04,
    "end": 20.54,
    "text": "You lose water, not toxins."
  },
  {
    "start": 20.57,
    "end": 22.06,
    "text": "The real detox?"
  },
  {
    "start": 22.09,
    "end": 23.33,
    "text": "Your liver and kidneys."
  },
  {
    "start": 23.36,
    "end": 25.7,
    "text": "No straightener required."
  }
]